DATABASE_URL=postgresql://ipaytech:password@localhost:5432/ipaytech_ops
DATABASE_SSL=false
# With DATABASE_SSL=true the server certificate is verified. Provide DATABASE_SSL_CA_FILE (path) or DATABASE_SSL_CA (PEM),
# or set DATABASE_SSL_REJECT_UNAUTHORIZED=false only if you knowingly accept an unverifiable certificate.
DATABASE_SSL_CA_FILE=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
DEFAULT_TIMEZONE=Africa/Harare
DEFAULT_CURRENCY=USD
STORAGE_DRIVER=local
# Set STORAGE_DRIVER=s3 in production and provide all S3_* variables below.
UPLOAD_MAX_SIZE_MB=10
HEALTHCHECK_DATABASE=false
HEALTHCHECK_STORAGE=false
LOG_LEVEL=info
# Required in production; must be an HTTPS endpoint that accepts metadata-only JSON error events.
ERROR_MONITORING_WEBHOOK_URL=
# Optional release provenance; Docker builds set these as APP_VERSION and DEPLOY_SHA.
APP_VERSION=
DEPLOY_SHA=
RESEND_API_KEY=
EMAIL_FROM=iPayTech Operations <notifications@ipaytechops.com>
EMAIL_REPLY_TO=
TRUST_PROXY=true
# Number of reverse proxies in front of the app (Dokploy/Traefik alone = 1; add 1 per CDN such as Cloudflare).
TRUSTED_PROXY_HOPS=1
# Bearer token required by POST /api/monitoring/errors. The endpoint is disabled while this is empty.
MONITORING_INGEST_TOKEN=
# Run migrations at container start. Set to false when migrations run as a Dokploy pre-deploy command.
RUN_MIGRATIONS=true
# Hours between automatic encrypted backups (production default 24; 0 disables).
BACKUP_INTERVAL_HOURS=24
# Required in production; development defaults to true unless explicitly set false.
REQUIRE_PRIVILEGED_MFA=false
# Required for encrypted PostgreSQL backups. Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
# Production platform organization authorized to view and request whole-database backups.
BACKUP_ADMIN_ORGANIZATION_ID=
BACKUP_STORAGE_PREFIX=backups
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
